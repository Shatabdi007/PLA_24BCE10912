import java.io.*;
import java.util.*;

public class Main {

    static class FastScanner {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st;

        String next() throws IOException {
            while (st == null || !st.hasMoreElements()) {
                st = new StringTokenizer(br.readLine());
            }
            return st.nextToken();
        }

        int nextInt() throws IOException {
            return Integer.parseInt(next());
        }
    }

    static boolean good(int[] a) {
        HashMap<Integer, Integer> first = new HashMap<>();
        HashMap<Integer, Integer> last = new HashMap<>();

        int n = a.length;

        for (int i = 0; i < n; i++) {
            first.putIfAbsent(a[i], i);
            last.put(a[i], i);
        }

        for (Map.Entry<Integer, Integer> e : first.entrySet()) {
            int val = e.getKey();
            int l = e.getValue();
            int r = last.get(val);
            for (int i = l; i <= r; i++) {
                if (a[i] != val) return false;
            }
        }
        return true;
    }

    public static void main(String[] args) throws Exception {
        FastScanner fs = new FastScanner();
        StringBuilder out = new StringBuilder();

        int T = fs.nextInt();

        while (T-- > 0) {
            int n = fs.nextInt();
            int[] a = new int[n];

            for (int i = 0; i < n; i++) a[i] = fs.nextInt();

            if (good(a)) {
                out.append("YES\n");
                continue;
            }

            ArrayList<Integer> bad = new ArrayList<>();

            HashMap<Integer, Integer> first = new HashMap<>();
            HashMap<Integer, Integer> last = new HashMap<>();

            for (int i = 0; i < n; i++) {
                first.putIfAbsent(a[i], i);
                last.put(a[i], i);
            }

            boolean[] mark = new boolean[n];

            for (Map.Entry<Integer, Integer> e : first.entrySet()) {
                int val = e.getKey();
                int l = e.getValue();
                int r = last.get(val);
                for (int i = l; i <= r; i++) {
                    if (a[i] != val && !mark[i]) {
                        mark[i] = true;
                        bad.add(i);
                    }
                }
            }

            if (bad.size() > 8) {
                out.append("NO\n");
                continue;
            }

            HashSet<Integer> cand = new HashSet<>(bad);

            for (int idx : bad) {
                int v = a[idx];
                cand.add(first.get(v));
                cand.add(last.get(v));
            }

            ArrayList<Integer> list = new ArrayList<>(cand);

            boolean ok = false;

            outer:
            for (int i = 0; i < list.size(); i++) {
                for (int j = i + 1; j < list.size(); j++) {
                    int x = list.get(i);
                    int y = list.get(j);

                    int tmp = a[x];
                    a[x] = a[y];
                    a[y] = tmp;

                    if (good(a)) {
                        ok = true;
                        break outer;
                    }

                    tmp = a[x];
                    a[x] = a[y];
                    a[y] = tmp;
                }
            }

            out.append(ok ? "YES\n" : "NO\n");
        }

        System.out.print(out);
    }
}
