import java.io.*;
import java.util.*;

public class Main {
    public static void main(String[] args) throws IOException {
        DataInputStream in = new DataInputStream(new BufferedInputStream(System.in, 1 << 16));
        StringBuilder sb = new StringBuilder();
        int t = nextInt(in);
        while (t-- > 0) {
            int n = nextInt(in);
            int m = nextInt(in);
            char[] s = nextToken(in, n);
            int[] a = new int[m];
            for (int i = 0; i < m; i++) a[i] = nextInt(in);

            HashMap<Integer, Integer> parent = new HashMap<>(Math.max(16, (n + m) * 2));
            for (int i = 0; i < m; i++) {
                int c = a[i];
                if (!parent.containsKey(c)) parent.put(c, c + 1);
            }

            int[] results = new int[n];
            int curPos = 1, prevPos = 1;
            for (int i = 1; i <= n; i++) {
                if (i > 1 && s[i - 2] == 'B') {
                    curPos = find(parent, prevPos + 1);
                }
                prevPos = curPos;
                if (s[i - 1] == 'A') {
                    curPos = curPos + 1;
                } else {
                    curPos = find(parent, curPos + 1);
                }
                if (!parent.containsKey(curPos)) parent.put(curPos, curPos + 1);
                results[i - 1] = curPos;
            }

            int[] all = new int[n + m];
            System.arraycopy(a, 0, all, 0, m);
            System.arraycopy(results, 0, all, m, n);
            Arrays.sort(all);
            int k = 0;
            for (int i = 0; i < all.length; i++) {
                if (i == 0 || all[i] != all[k - 1]) all[k++] = all[i];
            }
            sb.append(k).append('\n');
            for (int i = 0; i < k; i++) {
                sb.append(all[i]);
                if (i < k - 1) sb.append(' ');
            }
            sb.append('\n');
        }
        System.out.print(sb);
    }

    static int find(HashMap<Integer, Integer> parent, int x) {
        int root = x;
        while (true) {
            Integer p = parent.get(root);
            if (p == null) break;
            root = p;
        }
        int cur = x;
        while (true) {
            Integer p = parent.get(cur);
            if (p == null) break;
            if (p == root) break;
            parent.put(cur, root);
            cur = p;
        }
        return root;
    }

    private static int nextInt(DataInputStream in) throws IOException {
        int ret = 0;
        int b = in.read();
        while (b < '0' || b > '9') {
            b = in.read();
        }
        while (b >= '0' && b <= '9') {
            ret = ret * 10 + (b - '0');
            b = in.read();
        }
        return ret;
    }

    private static char[] nextToken(DataInputStream in, int len) throws IOException {
        char[] buf = new char[len];
        int b = in.read();
        while (b == ' ' || b == '\n' || b == '\r') b = in.read();
        int idx = 0;
        while (b != -1 && b != ' ' && b != '\n' && b != '\r') {
            buf[idx++] = (char) b;
            b = in.read();
        }
        return buf;
    }
}
