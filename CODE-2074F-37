import java.util.*;
import java.io.*;

public class Main {
    static long l1,r1,l2,r2;

    public static void main(String[] args) throws IOException {
        DataInputStream in = new DataInputStream(new BufferedInputStream(System.in, 1<<16));
        int t = nextInt(in);
        StringBuilder sb = new StringBuilder();
        long S = 1L<<20; // > 1e6, covers whole coordinate range
        for (int tc=0; tc<t; tc++) {
            l1 = nextInt(in);
            r1 = nextInt(in);
            l2 = nextInt(in);
            r2 = nextInt(in);
            long ans = cnt(0,0,S);
            sb.append(ans).append('\n');
        }
        System.out.print(sb);
    }

    // 0 = fully contained, 1 = disjoint, 2 = partial
    static int xState(long x, long s) {
        if (x>=l1 && x+s<=r1) return 0;
        if (x+s<=l1 || x>=r1) return 1;
        return 2;
    }
    static int yState(long y, long s) {
        if (y>=l2 && y+s<=r2) return 0;
        if (y+s<=l2 || y>=r2) return 1;
        return 2;
    }

    static long cnt(long x, long y, long s) {
        int xs = xState(x,s);
        int ys = yState(y,s);
        if (xs==1 || ys==1) return 0;
        if (xs==0 && ys==0) return 1;
        if (xs==0) return hY(y,s);
        if (ys==0) return hX(x,s);
        long s2 = s>>1;
        return cnt(x,y,s2)+cnt(x+s2,y,s2)+cnt(x,y+s2,s2)+cnt(x+s2,y+s2,s2);
    }

    static long hY(long y, long s) {
        int ys = yState(y,s);
        if (ys==1) return 0;
        if (ys==0) return 1;
        long s2 = s>>1;
        return 2*hY(y,s2) + 2*hY(y+s2,s2);
    }
    static long hX(long x, long s) {
        int xs = xState(x,s);
        if (xs==1) return 0;
        if (xs==0) return 1;
        long s2 = s>>1;
        return 2*hX(x,s2) + 2*hX(x+s2,s2);
    }

    private static int nextInt(DataInputStream in) throws IOException {
        int ret = 0;
        int b = in.read();
        while (b<'0'||b>'9') b = in.read();
        while (b>='0'&&b<='9') {
            ret = ret*10 + (b-'0');
            b = in.read();
        }
        return ret;
    }
}
