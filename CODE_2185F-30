import java.io.*;

public class Main {
    public static void main(String[] args) throws IOException {
        DataInputStream in = new DataInputStream(new BufferedInputStream(System.in, 1 << 16));
        StringBuilder sb = new StringBuilder();

        int t = nextInt(in);
        while (t-- > 0) {
            int n = nextInt(in);
            int q = nextInt(in);
            int sz = 1 << n;

            int[] a = new int[sz];
            for (int i = 0; i < sz; i++) a[i] = nextInt(in);

            // 1-indexed segment tree, tree[1..2*sz-1], leaves at [sz, 2*sz-1]
            int[] tree = new int[2 * sz];
            for (int i = 0; i < sz; i++) tree[sz + i] = a[i];
            for (int i = sz - 1; i >= 1; i--) tree[i] = tree[2 * i] ^ tree[2 * i + 1];

            for (int Q = 0; Q < q; Q++) {
                int b = nextInt(in);
                int c = nextInt(in);
                int pos = b - 1;
                int delta = a[pos] ^ c;

                int cur = 1;
                int acc = 0;

                for (int d = 0; d < n; d++) {
                    int bit = (pos >> (n - 1 - d)) & 1;
                    int leftChild = 2 * cur;
                    int rightChild = leftChild + 1;
                    int sizeOther = sz >> (d + 1);

                    int Lval = tree[leftChild];
                    int Rval = tree[rightChild];
                    if (bit == 0) Lval ^= delta;
                    else Rval ^= delta;

                    boolean winnerIsLeft = Lval >= Rval; // ties favor left (lower index)

                    if (bit == 0) {
                        // b is in left subtree
                        if (!winnerIsLeft) acc += sizeOther;
                        cur = leftChild;
                    } else {
                        // b is in right subtree
                        if (winnerIsLeft) acc += sizeOther;
                        cur = rightChild;
                    }
                }

                sb.append(acc).append('\n');
            }
        }

        System.out.print(sb);
    }

    private static int nextInt(DataInputStream in) throws IOException {
        int ret = 0;
        int b = in.read();
        while (b < '0' || b > '9') {
            b = in.read();
        }
        while (b >= '0' && b <= '9') {
            ret = ret * 10 + (b - '0');
            b = in.read();
        }
        return ret;
    }
}
